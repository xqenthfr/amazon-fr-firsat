# Bu dosyayı ".env" adıyla kopyalayın ve değerleri doldurun.
# .env dosyasını KİMSEYLE paylaşmayın, GitHub'a yüklemeyin.

# Telegram (ücretsiz) — README'deki BotFather adımlarına bakın
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Keepa (ÜCRETLİ, isteğe bağlı) — boş bırakırsanız Keepa hiç kullanılmaz
KEEPA_API_KEY=
